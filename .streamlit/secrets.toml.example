# Copier en .streamlit/secrets.toml (non versionné) pour lire les tables gold du SQL warehouse.
# Sans ce fichier, l'application affiche l'instantané de démonstration (dashboard/demo_data/).
[databricks]
server_hostname = "dbc-xxxxxxxx-xxxx.cloud.databricks.com"   # SQL Warehouses → Connection details
http_path = "/sql/1.0/warehouses/xxxxxxxxxxxxxxxx"
access_token = "dapi..."                                      # Settings → Developer → Access tokens
catalog = "workspace"
schema = "mobility"
